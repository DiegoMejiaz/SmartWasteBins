<mxfile host="drawio_lib"><diagram id="d1" name="Actividades"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de actividades — Ciclo Operativo de Depósito y Reciclaje&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;UML 2.5.1 cláusula 15 — Nodos de acción, decisiones, ramas y guardas operativas&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;act Ciclo de depósito en estación SmartBin&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=334;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1120" height="1080" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="26" height="26" as="geometry"/></mxCell><mxCell id="c5" value="Ciudadano abre app y escanea&lt;br&gt;código QR de la estación" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="240" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Seleccionar tipo de residuo&lt;br&gt;(Plástico, Vidrio, Electrónico, Papel)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="260" height="50" as="geometry"/></mxCell><mxCell id="