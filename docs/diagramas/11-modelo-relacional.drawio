="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c20"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c23" value="fk_residuo_smartbin" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c23"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c25" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c23"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c26" value="Reglas de Integridad Referencial (bd_smartbin):&lt;br&gt;• fk_cuenta_usuario: ON DELETE CASCADE (un usuario posee 1 monedero)&lt;br&gt;• fk_transaccion_cuenta: ON DELETE CASCADE (auditoría en cascada)&lt;br&gt;• fk_residuo_usuario: ON DELETE CASCADE&lt;br&gt;• fk_residuo_smartbin: ON DELETE RESTRICT (historial de pesaje protegido)&lt;br&gt;• Regla de Negocio: capacidad_maxima = 50.0 kg; si nivel_actual &amp;gt;= 50.0 -&amp;gt; estado = &amp;#x27;Bloqueado&amp;#x27;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="480" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>