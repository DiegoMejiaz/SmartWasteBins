<mxfile host="drawio_lib"><diagram id="d1" name="Modelo relacional"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Modelo relacional — Base de Datos bd_smartbin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Tablas normalizadas, claves primarias «PK», claves foráneas «FK» y únicas «UK» (Perfil Ambler)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1670" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;rel Esquema físico relacional en motor MariaDB InnoDB&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=416;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1670" height="880" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;usuario&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="340" height="141" as="geometry"/></mxCell><mxCell id="c5" value="«PK» id_usuario: INT&lt;br&gt;«UK» correo: VARCHAR(100)&lt;br&gt;«UK» usuario: VARCHAR(50)&lt;br&gt;nombre: VARCHAR(100)&lt;br&gt;rol: VARCHAR(20)&lt;br&gt;qr_code: VARCHAR(255) NULL&lt;br&gt;fecha_registro: DATETIME" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helv